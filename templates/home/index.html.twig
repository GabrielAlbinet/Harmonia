{% extends 'base.html.twig' %}

{% block title %}Harmonia - Liste d'albums{% endblock %}

{% block body %}
    <div class="container">
        <div class="d-flex gap-2 mb-3">
            <a href="{{ path('app_album_create') }}" class="btn btn-success">Ajouter un album</a>
            <a href="{{ path('app_album_delete') }}" class="btn btn-danger">Supprimer un album</a>
            <a href="{{ path('app_artist_add') }}" class="btn btn-primary">Ajouter un artiste</a>
        </div>
        <h2>Albums</h2>
        <div class="row">
            {% for alb in album %}
                {% include 'component/album-card.html.twig' with {'album': alb} %}
            {% endfor %}
        </div>

        <h2>EP</h2>
        <div class="row">
            {% for alb in EP %}
                {% include 'component/album-card.html.twig' with {'album': alb} %}
            {% endfor %}
        </div>

        <h2>Singles</h2>
        <div class="row">
            {% for alb in single %}
                {% include 'component/album-card.html.twig' with {'album': alb} %}
            {% endfor %}
        </div>

        <h2>Les Albums sortis après 2020</h2>
        <div class="row">
            {% for alb in albumsPost2020s %}
                {% include 'component/album-card.html.twig' with {'album': alb} %}
            {% endfor %}
        </div>

        <h2>Les albums sortis avant 2020</h2>
        <div class="row">
            {% for alb in albumsPre2020s %}
                {% include 'component/album-card.html.twig' with {'album': alb} %}
            {% endfor %}
        </div>
    </div>
{% endblock %}
 