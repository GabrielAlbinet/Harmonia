{% extends 'base.html.twig' %}

{% block title %}Harmonia - Liste d'albums{% endblock %}

{% block body %}
    <div class="container">
        <div class="d-flex gap-2 mb-3">
            <a href="{{ path('app_album_create') }}" class="btn btn-success">Ajouter un album</a>
            <a href="{{ path('app_album_delete') }}" class="btn btn-danger">Supprimer un album</a>
            <a href="{{ path('app_artist_add') }}" class="btn btn-primary">Ajouter un artiste</a>
        </div>

        {% include 'component/album-section.html.twig' with {'title': 'Albums', 'albums': album} only %}
        {% include 'component/album-section.html.twig' with {'title': 'EP', 'albums': EP} only %}
        {% include 'component/album-section.html.twig' with {'title': 'Singles', 'albums': single} only %}
        {% include 'component/album-section.html.twig' with {'title': 'Les albums sortis après 2020', 'albums': albumsPost2020s} only %}
        {% include 'component/album-section.html.twig' with {'title': 'Les albums sortis avant 2020', 'albums': albumsPre2020s} only %}
    </div>
{% endblock %}