{% extends 'base.html.twig' %}

{% block title %}Harmonia{% endblock %}

{% block body %}
    <div class="container">
        <h2>Albums</h2>
        <div class="row">
            {% for alb in album %}
                <div class="col-md-3 mb-4">
                    <a href="{{ path('app_album_item', {'id': alb.id}) }}" class="text-decoration-none text-dark">
                        <div class="card h-100">
                            <img src="{{ asset(alb.cover) }}" class="card-img-top">
                            <div class="card-body">
                                <h5 class="card-title">{{ alb.label }}</h5>
                                <p class="card-text">{{ alb.artist.label }}</p>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>

        <h2>EP</h2>
        <div class="row">
            {% for alb in EP %}
                <div class="col-md-3 mb-4">
                    <a href="{{ path('app_album_item', {'id': alb.id}) }}" class="text-decoration-none text-dark">
                        <div class="card h-100">
                            <img src="{{ asset(alb.cover) }}" class="card-img-top">
                            <div class="card-body">
                                <h5 class="card-title">{{ alb.label }}</h5>
                                <p class="card-text">{{ alb.artist.label }}</p>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>

        <h2>Singles</h2>
        <div class="row">
            {% for alb in single %}
                <div class="col-md-3 mb-4">
                    <a href="{{ path('app_album_item', {'id': alb.id}) }}" class="text-decoration-none text-dark">
                        <div class="card h-100">
                            <img src="{{ asset(alb.cover) }}" class="card-img-top">
                            <div class="card-body">
                                <h5 class="card-title">{{ alb.label }}</h5>
                                <p class="card-text">{{ alb.artist.label }}</p>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}