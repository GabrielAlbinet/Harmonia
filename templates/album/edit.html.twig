{% extends 'base.html.twig' %}

{% block title %}Modifier l'album{% endblock %}

{% block body %}
    <div class="container">
        <h1>Modifier l'album</h1>

        {{ form_start(form) }}
            {{ form_row(form.label) }}
            {{ form_row(form.artist) }}
            {{ form_row(form.type) }}
            {{ form_row(form.coverFile) }}
            <button type="submit" class="btn btn-primary">Valider</button>
        {{ form_end(form) }}
    </div>
{% endblock %}