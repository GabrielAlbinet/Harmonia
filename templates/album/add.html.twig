{% extends 'base.html.twig' %}

{% block title %}Ajouter un album{% endblock %}

{% block body %}
    <h1>Ajouter un album</h1>

    {{ form_start(form) }}
        {{ form_row(form.label) }}
        {{ form_row(form.artist) }}
        {{ form_row(form.type) }}
        {{ form_row(form.cover) }}
        <button type="submit" class="btn btn-primary">Valider</button>
    {{ form_end(form) }}
{% endblock %}