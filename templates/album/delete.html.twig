{% extends 'base.html.twig' %}

{% block title %}Supprimer un album{% endblock %}

{% block body %}
    <div class="container">
        <h1>Supprimer un album</h1>
        <p class="text-danger">Attention : supprimer un album supprime aussi tous ses morceaux.</p>
        {{ form_start(form) }}
            {{ form_row(form.album) }}
            <button type="submit" class="btn btn-danger">Supprimer</button>
        {{ form_end(form) }}
    </div>
{% endblock %}