{% extends 'base.html.twig' %}

{% block title %}{{ album.label }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <img src="{{ asset(album.cover) }}">
            </div>
            <div class="col-md-8">
                <h1>{{ album.label }}</h1>
                <p>Artiste : {{ album.artist.label }}</p>
                <p>Type : {{ album.type.value }}</p>
                <p>Date de sortie : {{ album.createdAt|date('d/m/Y') }}</p>
                <p class="card-text"><small class="text-muted">{{ album.tracks|length }} morceau(x) — {{ album.getTotalDuration() }} minutes</small></p>
                <a href="{{ path('app_track_add', {'id': album.id}) }}" class="btn btn-success mt-3">Ajouter une musique</a>
                <a href="{{ path('app_album_edit', {'id': album.id}) }}" class="btn btn-primary mt-3">Modifier l'album</a>
            </div>
        </div>
    </div>
{% endblock %}