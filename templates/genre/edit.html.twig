{% extends 'base.html.twig' %}

{% block title %}Modifier un genre{% endblock %}

{% block body %}
    <div class="container">
        <h1>Modifier un genre</h1>
        {{ form_start(form) }}
            {{ form_row(form.label) }}
            {{ form_row(form.color) }}
            <button type="submit" class="btn btn-primary">Valider</button>
        {{ form_end(form) }}
    </div>
{% endblock %}