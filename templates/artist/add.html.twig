{% extends 'base.html.twig' %}

{% block title %}Ajouter un artiste{% endblock %}

{% block body %}
    <h1>Ajouter un artiste</h1>

    {{ form_start(form) }}
        {{ form_row(form.label) }}
        {{ form_row(form.biography) }}
        {{ form_row(form.country) }}
        <button type="submit" class="btn btn-primary">Valider</button>
    {{ form_end(form) }}
{% endblock %}